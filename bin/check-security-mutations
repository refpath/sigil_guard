#!/usr/bin/env sh
set -eu
export MIX_ENV=test
mkdir -p _build/security-mutations
for target in crypto replay_store attestation/digest runtime/stream trust_bundle/verify \
  effect_authority effect_authority/record effect_authority/facts \
  effect_authority/envelope effect_authority/outcome; do
  case "${target}" in
    crypto) tests=test/sigil_guard/crypto_test.exs ;;
    replay_store) tests=test/sigil_guard/replay_store_test.exs ;;
    attestation/digest) tests=test/sigil_guard/attestation/digest_test.exs ;;
    runtime/stream) tests=test/sigil_guard/runtime/stream_test.exs,test/sigil_guard/runtime/streaming_vectors_test.exs ;;
    trust_bundle/verify) tests=test/sigil_guard/trust_bundle ;;
    effect_authority*) tests=test/sigil_guard/effect_authority_test.exs ;;
  esac
  report="_build/security-mutations/$(printf '%s' "${target}" | tr / _).json"
  rm -f "${report}"
  mix muex --files "lib/sigil_guard/${target}.ex" --test-paths "${tests}" \
    --no-filter --no-optimize --no-tce --mutators arithmetic,comparison --max-mutations 12 --fail-at 100 \
    --concurrency 1 --timeout 30000 --format json --output "${report}"
  test -s "${report}"
done
